{
  "name": "gomtin",
  "productName": "GomTin",
  "version": "1.0.0",
  "description": "Personal distraction-free desktop chat hub for Messenger, Zalo and Telegram",
  "main": "src/main.js",
  "private": true,
  "author": "Personal Build",
  "license": "Apache-2.0",
  "scripts": {
    "start": "NODE_ENV=development electron .",
    "test": "node --test",
    "build:dev": "electron-builder --mac dir --config build/electron-builder.dev.json",
    "build:prod": "electron-builder --mac dir",
    "app:mac": "electron-builder --mac dir",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.tuyennq.gomtin",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "electronFuses": {
      "enableCookieEncryption": true,
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": true
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.social-networking",
      "identity": "Apple Development: tuyennq1001@gmail.com (DGWT97FSZ4)",
      "timestamp": "none",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "GomTin-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSUserNotificationAlertStyle": "alert",
        "NSMicrophoneUsageDescription": "GomTin calls need the microphone.",
        "NSCameraUsageDescription": "GomTin video calls need the camera."
      }
    },
    "win": {
      "target": [
        "zip",
        "nsis"
      ],
      "artifactName": "GomTin-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "GomTin-${version}-win-${arch}-setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "maintainer": "Personal Build",
      "synopsis": "Multi-service distraction-free desktop chat hub",
      "artifactName": "GomTin-${version}-linux-${arch}.${ext}"
    }
  }
}
